{
  "name": "ideal",
  "productName": "IDEAL",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node -e \"process.env.NODE_ENV='production'; require('./dist-server/server.cjs')\"",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"for (const p of ['dist','dist-server','release']) require('node:fs').rmSync(p,{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "postinstall": "electron-builder install-app-deps",
    "test:data-protection": "tsx scripts/test-data-protection.ts",
    "test:lifecycle": "tsx scripts/test-lifecycle.ts",
    "test:regressions": "tsx scripts/test-regressions.ts",
    "check:french-ui": "node scripts/check-french-ui.cjs",
    "test:e2e": "playwright test",
    "test:simulation": "tsx scripts/test-simulation.ts",
    "dist:win:store": "npm run build && node scripts/build-store-package.cjs",
    "test:migrations": "tsx scripts/test-migration-chain.ts"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.2.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.6.2",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.21",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "build": {
    "appId": "dz.ideal.desktop",
    "productName": "IDEAL",
    "asar": true,
    "asarUnpack": [
      "**/*.node",
      "dist-server/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "IDEAL-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IDEAL",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronFuses": {
      "runAsNode": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lunderclub9-gif",
        "repo": "Ideal",
        "releaseType": "release"
      }
    ]
  },
  "description": "IDEAL — application de gestion locale pour les entreprises.",
  "author": "IDEAL"
}
